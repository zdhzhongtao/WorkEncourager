<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WorkEncourager</AssemblyName>
    <RootNamespace>WorkEncourager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Company>zhend</Company>
    <Product>上班鼓励器</Product>
    <AssemblyTitle>上班鼓励器</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="WorkEnc.Core\WorkEnc.Core.csproj" />
  </ItemGroup>

  <!-- 主项目只编译根目录源码，排除子项目（Core / Tests）里的文件 -->
  <ItemGroup>
    <Compile Remove="WorkEnc.Core\**\*.cs" />
    <Compile Remove="WorkEnc.Tests\**\*.cs" />
    <None Remove="WorkEnc.Core\**" />
    <None Remove="WorkEnc.Tests\**" />
    <EmbeddedResource Remove="WorkEnc.Core\**" />
    <EmbeddedResource Remove="WorkEnc.Tests\**" />
  </ItemGroup>

</Project>
