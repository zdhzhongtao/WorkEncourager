<Window x:Class="WorkEncourager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="上班鼓励器"
        Width="456" Height="644" MinWidth="360" MinHeight="400"
        SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <!--
    注意：不要使用 shell:WindowChrome 来做边缘缩放。
    AllowsTransparency=True 的窗口是分层窗口，没有非客户区（non-client area），
    WindowChrome 的 ResizeBorderThickness 完全失效，鼠标移到边缘拖不动大小。
    这里改用自绘的 8 向缩放热区（见文件末尾），由代码手动改 Width/Height/Left/Top。
  -->

  <Window.Resources>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FB923C" Offset="0" />
      <GradientStop Color="#F97316" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#34D399" Offset="0" />
      <GradientStop Color="#12B76A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MoneyGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F97316" Offset="0" />
      <GradientStop Color="#F43F5E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FCD34D" Offset="0" />
      <GradientStop Color="#FB923C" Offset="0.6" />
      <GradientStop Color="#F97316" Offset="1" />
    </LinearGradientBrush>

    <!-- 图标按钮 -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A94A6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F2F4F7" />
                <Setter Property="Foreground" Value="#0F172A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E9EDF2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="11" Background="{StaticResource AccentGrad}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="11" Background="{StaticResource GreenGrad}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次级按钮 -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="11" Background="#FBFCFD" BorderBrush="#E9EDF2" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8DFE9" />
                <Setter TargetName="b" Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#0F172A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F2F4F7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框 -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="CaretBrush" Value="#F97316" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="10" Background="#FBFCFE" BorderBrush="#E9EDF2" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FDBA74" />
                <Setter TargetName="b" Property="Background" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#475467" />
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>

    <!-- 星期切换 -->
    <Style x:Key="DowTgl" TargetType="ToggleButton">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8A94A6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" CornerRadius="9" Background="#FBFCFE" BorderBrush="#E9EDF2" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8DFE9" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFF3E6" />
                <Setter TargetName="b" Property="BorderBrush" Value="#FDBA74" />
                <Setter Property="Foreground" Value="#C2410C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 滑块 -->
    <Style x:Key="SlimSlider" TargetType="Slider">
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="5" CornerRadius="3" Background="#EFF2F7" VerticalAlignment="Center" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" CornerRadius="3" Background="#FB923C" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="15" Height="15" Fill="#F97316" Stroke="#FFFFFF" StrokeThickness="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" CornerRadius="3" Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 数据小卡 -->
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#FBFCFE" />
      <Setter Property="BorderBrush" Value="#EFF2F7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10,12,10" />
    </Style>

    <!-- 语气/主题切换按钮 -->
    <Style x:Key="ToggleIdle" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8A94A6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="#FBFCFE" BorderBrush="#E9EDF2" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#D8DFE9" />
                <Setter Property="Foreground" Value="#0F172A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToggleActive" TargetType="Button" BasedOn="{StaticResource ToggleIdle}">
      <Setter Property="Foreground" Value="#C2410C" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="9" Background="#FFF3E6" BorderBrush="#FDBA74" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFE8D5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 窗口边缘缩放热区：透明窗口无法用系统 resize 边框，这里自绘 -->
    <Style x:Key="ResizeGrip" TargetType="Rectangle">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </Window.Resources>

  <Grid x:Name="WindowRoot">
  <Grid x:Name="RootGrid" Margin="16">
    <!-- Viewbox：窗口放大缩小时内容等比自适应 -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
     <Grid Width="424">
    <!-- 完整面板 -->
    <StackPanel x:Name="FullPanel">
    <!-- 主面板 -->
    <Border x:Name="Shell" CornerRadius="22" Background="#EDFFFFFF" BorderBrush="#E7ECF3" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.18" Color="#0F172A" />
      </Border.Effect>

      <StackPanel Margin="18,16,18,14">

        <!-- 头部 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentGrad}" VerticalAlignment="Center">
            <TextBlock Text="¥" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"
                       FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
          </Border>

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="上班鼓励器" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="SubTitleText" Text="每一秒都在进账" FontSize="10" Foreground="#8A94A6" Margin="0,1,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="StatsBtn" Style="{StaticResource IconBtn}" Content="&#xE9D9;" ToolTip="历史统计" />
            <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Content="&#xE718;" ToolTip="置顶开关" Margin="1,0,0,0" />
            <Button x:Name="SettingsBtn" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="设置" Margin="1,0,0,0" />
            <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Content="&#xE8BB;" ToolTip="关闭" Margin="1,0,0,0" />
          </StackPanel>
        </Grid>

        <!-- 日期时间 + 状态 -->
        <Grid Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="DateText" FontSize="11.5" FontWeight="SemiBold" Foreground="#475467" Text="--" />
            <TextBlock x:Name="TimeText" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#0F172A"
                       Margin="7,0,0,0" Text="--:--:--" />
          </StackPanel>
          <Border x:Name="StatusChip" HorizontalAlignment="Right" CornerRadius="10" Background="#ECFDF3" Padding="8,3,9,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#12B76A" VerticalAlignment="Center" />
              <TextBlock x:Name="StatusText" FontSize="10.5" FontWeight="SemiBold" Foreground="#067647" Margin="5,0,0,0" Text="上班中" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 金额区 -->
        <Grid Margin="0,12,0,0">
          <TextBlock x:Name="AmountLabel" Text="今日已赚" FontSize="11" Foreground="#8A94A6" VerticalAlignment="Center" />
          <Border x:Name="CountChip" HorizontalAlignment="Right" CornerRadius="9" Background="#FFF7ED"
                  BorderBrush="#FED7AA" BorderThickness="1" Padding="8,3,9,3">
            <TextBlock x:Name="CountText" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309"
                       FontFamily="Consolas" Text="距下班 00:00:00" />
          </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="¥" FontSize="20" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Bottom" Margin="0,0,5,4" />
          <TextBlock x:Name="EarnedText" Text="0.0000" FontSize="38" FontWeight="Bold" FontFamily="Consolas"
                     Typography.NumeralAlignment="Tabular" VerticalAlignment="Bottom">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F97316" Offset="0" />
                <GradientStop Color="#F43F5E" Offset="1" />
              </LinearGradientBrush>
            </TextBlock.Foreground>
          </TextBlock>
        </StackPanel>

        <Border x:Name="SpeedCard" Background="#FBFCFE" BorderBrush="#EFF2F7" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,8,0,0">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="SpeedLabel" Text="当前赚钱速度" FontSize="11" Foreground="#8A94A6" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="RateText" Text="0.0000" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="UnitText" Text="元/秒" FontSize="10.5" Foreground="#8A94A6" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="DailyTipText" Margin="0,4,0,0" FontSize="10" Foreground="#A5AEBD"
                       Text="日薪 ¥0.0000 · 满勤 9.0 小时" />
          </StackPanel>
        </Border>

        <!-- 鼓励语 -->
        <Border x:Name="EncCard" Background="#FFF8F1" BorderBrush="#FBE3C7" BorderThickness="1" CornerRadius="12" Padding="11,9" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M9 3.6 L5.4 5.6 L3.2 9.2 L6.2 11 L7.6 9.9 L7.6 20.4 L16.4 20.4 L16.4 9.9 L17.8 11 L20.8 9.2 L18.6 5.6 L15 3.6 C14.2 5.4 9.8 5.4 9 3.6 Z"
                  Fill="#FB923C" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="EncText" Grid.Column="1" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                       Foreground="#9A3412" VerticalAlignment="Center" Text="正在计算…" LineHeight="18" />
          </Grid>
        </Border>

        <!-- 按钮 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ToggleBtn" Style="{StaticResource PrimaryBtn}" Content="关闭计时器" />
          <Button x:Name="ResetBtn" Grid.Column="1" Style="{StaticResource GhostBtn}" Content="重置" Width="66" Margin="8,0,0,0" />
        </Grid>

        <Border x:Name="Divider" Height="1" Background="#F1F4F8" Margin="0,14,0,12" />

        <!-- 进度 -->
        <Grid>
          <TextBlock x:Name="ProgressLabel" Text="今日工时进度" FontSize="11.5" FontWeight="SemiBold" Foreground="#475467" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="PctText" Text="0.0" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#F97316" />
            <TextBlock Text="%" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Bottom" Margin="1,0,0,2" />
          </StackPanel>
        </Grid>

        <Border x:Name="BarHost" Height="10" CornerRadius="5" Background="#F1F4F8" Margin="0,8,0,0">
          <Border x:Name="BarFill" Width="0" CornerRadius="5" HorizontalAlignment="Left">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FCD34D" Offset="0" />
                <GradientStop Color="#FB923C" Offset="0.6" />
                <GradientStop Color="#F97316" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Border>

        <Grid Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="WorkedLabel" Text="已工作" FontSize="11" Foreground="#8A94A6" />
            <TextBlock x:Name="WorkedText" Text="0.00" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" Margin="4,0,0,0" />
            <TextBlock x:Name="TotalLabel" Text="/" FontSize="11" Foreground="#8A94A6" Margin="4,0,0,0" />
            <TextBlock x:Name="TotalText" Text="8.0" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" Margin="4,0,0,0" />
            <TextBlock Text="小时" FontSize="11" Foreground="#8A94A6" Margin="3,0,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="RemainLabel" Text="剩余" FontSize="11" Foreground="#8A94A6" />
            <TextBlock x:Name="RemainText" Text="8.00" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#475467" Margin="4,0,0,0" />
            <TextBlock Text="小时" FontSize="11" Foreground="#8A94A6" Margin="3,0,0,0" />
          </StackPanel>
        </Grid>

        <!-- 数据卡 -->
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="MonthCard" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource StatCard}">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="MonthLabel" Text="本月累计" FontSize="10.5" Foreground="#8A94A6" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="MonthPctText" Text="0.0" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Foreground="#F97316" />
                  <TextBlock Text="% 月薪" FontSize="9.5" Foreground="#A5AEBD" Margin="2,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="¥" FontSize="12" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Bottom" Margin="0,0,4,2" />
                <TextBlock x:Name="MonthText" Text="0.0000" FontSize="19" FontWeight="Bold" FontFamily="Consolas"
                           Typography.NumeralAlignment="Tabular">
                  <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#F97316" Offset="0" />
                      <GradientStop Color="#F43F5E" Offset="1" />
                    </LinearGradientBrush>
                  </TextBlock.Foreground>
                </TextBlock>
              </StackPanel>
              <Border x:Name="MonthBarHost" Height="6" CornerRadius="3" Background="#F1F4F8" Margin="0,7,0,0">
                <Border x:Name="MonthBarFill" Width="0" CornerRadius="3" HorizontalAlignment="Left">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#FB923C" Offset="0" />
                      <GradientStop Color="#F43F5E" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Border>
              <TextBlock x:Name="MonthNote" FontSize="9.5" Foreground="#A5AEBD"
                         TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
          </Border>

          <Border x:Name="HourlyCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,8,4,0">
            <StackPanel>
              <TextBlock x:Name="HourlyLabel" Text="时薪" FontSize="10.5" Foreground="#8A94A6" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="¥" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" VerticalAlignment="Bottom" Margin="0,0,3,1" />
                <TextBlock x:Name="HourlyText" Text="0.0000" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A"
                           Typography.NumeralAlignment="Tabular" />
              </StackPanel>
              <TextBlock x:Name="HourlyNote" FontSize="9.5" Foreground="#A5AEBD" Margin="0,4,0,0" Text="日薪 ÷ 计薪工时" />
            </StackPanel>
          </Border>

          <Border x:Name="FullCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,8,0,0">
            <StackPanel>
              <TextBlock x:Name="FullLabel" Text="今日满勤可得" FontSize="10.5" Foreground="#8A94A6" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="¥" FontSize="11" FontWeight="Bold" Foreground="#8A94A6" VerticalAlignment="Bottom" Margin="0,0,3,1" />
                <TextBlock x:Name="FullText" Text="0.0000" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A"
                           Typography.NumeralAlignment="Tabular" />
              </StackPanel>
              <TextBlock x:Name="FullNote" FontSize="9.5" Foreground="#A5AEBD" Margin="0,4,0,0" Text="月薪 ÷ 21.75 天" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 发薪日 + 实际在场时长 -->
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border x:Name="PayDayCard" Grid.Column="0" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock x:Name="PayDayText" Text="距发薪 -- 天" FontSize="12.5" FontWeight="Bold" Foreground="#C2410C" />
              <TextBlock x:Name="PayDaySubText" FontSize="9.5" Foreground="#8A94A6" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border x:Name="ActualWorkedCard" Grid.Column="2" Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock x:Name="ActualWorkedLabel" Text="今日实际在场" FontSize="10.5" Foreground="#8A94A6" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock x:Name="ActualWorkedText" Text="0.00" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="小时" FontSize="10" Foreground="#8A94A6" Margin="3,0,0,0" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock FontSize="9.5" Foreground="#A5AEBD" Margin="0,4,0,0" Text="程序开着即在岗，用于 CSV 报表" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock x:Name="FooterHint" Text="拖动任意空白处移动窗口 · 设置自动保存" FontSize="9.5" Foreground="#B4BCC9"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
    </StackPanel>

    <!-- 极简模式面板 -->
    <StackPanel x:Name="CompactPanel" Visibility="Collapsed">
      <Border x:Name="CompactShell" CornerRadius="20" Background="#EDFFFFFF" BorderBrush="#E7ECF3" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <Grid Margin="16,14,16,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <TextBlock x:Name="CompactTitle" Text="上班鼓励器" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="CompactCount" HorizontalAlignment="Right" FontSize="10" FontFamily="Consolas"
                       FontWeight="SemiBold" Foreground="#C2410C" Text="距下班 00:00:00" />
          </Grid>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="¥" FontSize="15" FontWeight="Bold" Foreground="#F97316" VerticalAlignment="Bottom" Margin="0,0,4,3" />
            <TextBlock x:Name="CompactEarned" Text="0.0000" FontSize="27" FontWeight="Bold" FontFamily="Consolas"
                       Typography.NumeralAlignment="Tabular" Foreground="#F97316" VerticalAlignment="Bottom" />
          </StackPanel>

          <TextBlock x:Name="CompactStatus" Grid.Row="2" FontSize="10" Foreground="#8A94A6" Margin="0,4,0,0" Text="上班中" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 统计层 -->
    <Grid x:Name="StatsLayer" Visibility="Collapsed">
      <Border x:Name="StatsShell" CornerRadius="22" Background="#FDFEFF" BorderBrush="#E7ECF3" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <Grid Margin="18,16,18,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="StatsTitleText" Text="历史统计" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" />
              <TextBlock x:Name="StatsSubText" Text="基于程序运行期间记录的在场时长" FontSize="10" Foreground="#8A94A6" Margin="0,1,0,0" />
            </StackPanel>
            <Button x:Name="CloseStatsBtn" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatWeekCard" Style="{StaticResource StatCard}">
                  <StackPanel>
                    <TextBlock Text="本周" FontSize="10.5" Foreground="#8A94A6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock x:Name="StatWeekHours" Text="0.00" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                      <TextBlock Text="小时" FontSize="10" Foreground="#8A94A6" Margin="3,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="StatWeekEarned" FontSize="10" Foreground="#C2410C" Margin="0,4,0,0" Text="¥0.0000" />
                  </StackPanel>
                </Border>
                <Border x:Name="StatMonthCard" Grid.Column="2" Style="{StaticResource StatCard}">
                  <StackPanel>
                    <TextBlock Text="本月" FontSize="10.5" Foreground="#8A94A6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock x:Name="StatMonthHours" Text="0.00" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                      <TextBlock Text="小时" FontSize="10" Foreground="#8A94A6" Margin="3,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="StatMonthEarned" FontSize="10" Foreground="#C2410C" Margin="0,4,0,0" Text="¥0.0000" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatYearCard" Style="{StaticResource StatCard}">
                  <StackPanel>
                    <TextBlock Text="本年" FontSize="10.5" Foreground="#8A94A6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock x:Name="StatYearHours" Text="0.00" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                      <TextBlock Text="小时" FontSize="10" Foreground="#8A94A6" Margin="3,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="StatYearEarned" FontSize="10" Foreground="#C2410C" Margin="0,4,0,0" Text="¥0.0000" />
                  </StackPanel>
                </Border>
                <Border x:Name="StatOvertimeCard" Grid.Column="2" Style="{StaticResource StatCard}">
                  <StackPanel>
                    <TextBlock Text="累计加班" FontSize="10.5" Foreground="#8A94A6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock x:Name="StatOvertimeHours" Text="0.00" FontSize="17" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" />
                      <TextBlock Text="小时" FontSize="10" Foreground="#8A94A6" Margin="3,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="StatOvertimeDays" FontSize="10" Foreground="#8A94A6" Margin="0,4,0,0" Text="0 天有加班" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border x:Name="StatDetailCard" Style="{StaticResource StatCard}" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="明细" FontSize="10.5" Foreground="#8A94A6" />
                  <TextBlock x:Name="StatDetailText" Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold"
                             Foreground="#475467" TextWrapping="Wrap" LineHeight="18" Text="—" />
                </StackPanel>
              </Border>

              <TextBlock Text="数据导出" Style="{StaticResource FieldLabel}" Margin="2,14,0,5" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="StatsExportCsvBtn" Style="{StaticResource GhostBtn}" Content="导出工时 CSV" Width="102" Height="32" />
                <Button x:Name="StatsExportMonthlyBtn" Style="{StaticResource GhostBtn}" Content="导出月度汇总" Width="102" Height="32" Margin="6,0,0,0" />
              </StackPanel>
              <TextBlock FontSize="9.5" Foreground="#A5AEBD" Margin="2,6,0,0" TextWrapping="Wrap"
                         Text="CSV 保存在 %APPDATA%\WorkEncourager\，UTF-8 BOM 编码，Excel 直接打开。" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBox x:Name="StatsTip" FontSize="10" Foreground="#EF4444" Margin="0,0,0,0"
                     Text="" TextWrapping="Wrap" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" BorderThickness="0" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="StatsCopyPathBtn" Style="{StaticResource GhostBtn}"
                      Content="复制路径" Width="76" Height="26" />
              <Button x:Name="StatsOpenFolderBtn" Style="{StaticResource GhostBtn}"
                      Content="打开文件夹" Width="86" Height="26" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- 设置层 -->
    <Grid x:Name="SettingsLayer" Visibility="Collapsed">
      <Border x:Name="SettingsShell" CornerRadius="22" Background="#FDFEFF" BorderBrush="#E7ECF3" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.18" Color="#0F172A" />
        </Border.Effect>
        <Grid Margin="18,16,18,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SettingsTitleText" Text="设置" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" />
              <TextBlock x:Name="SettingsSubText" Text="数据只保存在本机" FontSize="10" Foreground="#8A94A6" Margin="0,1,0,0" />
            </StackPanel>
            <Button x:Name="CloseSettingsBtn" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                    HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="关闭" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel>

          <TextBlock Text="月薪（元）" Style="{StaticResource FieldLabel}" Margin="2,4,0,5" />
          <TextBox x:Name="InSalary" Style="{StaticResource Input}" />
          <TextBlock FontSize="9.5" Foreground="#A5AEBD" Margin="2,5,0,0"
                     Text="日薪 = 月薪 ÷ 21.75（法定月计薪天数）" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="上班时间" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="InStart" Style="{StaticResource Input}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="下班时间" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="InEnd" Style="{StaticResource Input}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="午休时段（可留空，格式 12:00-13:00）" Style="{StaticResource FieldLabel}" Margin="2,10,0,5" />
          <TextBox x:Name="InBreak" Style="{StaticResource Input}" />
          <TextBlock x:Name="AutoHoursText" FontSize="10" Foreground="#475467" Margin="2,7,0,0"
                     Text="每日计薪工时 9.0 小时（09:00 → 18:00，无午休）" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="目标物名称" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="InGoalItem" Style="{StaticResource Input}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="每月发薪日" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="InPayDay" Style="{StaticResource Input}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="目标物单价（元 / 件）" Style="{StaticResource FieldLabel}" Margin="2,10,0,5" />
          <TextBox x:Name="InShirt" Style="{StaticResource Input}" />

          <TextBlock Text="本月计薪日" Style="{StaticResource FieldLabel}" Margin="2,12,0,5" />
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="Dw1" Style="{StaticResource DowTgl}" Content="一" />
            <ToggleButton x:Name="Dw2" Style="{StaticResource DowTgl}" Content="二" />
            <ToggleButton x:Name="Dw3" Style="{StaticResource DowTgl}" Content="三" />
            <ToggleButton x:Name="Dw4" Style="{StaticResource DowTgl}" Content="四" />
            <ToggleButton x:Name="Dw5" Style="{StaticResource DowTgl}" Content="五" />
            <ToggleButton x:Name="Dw6" Style="{StaticResource DowTgl}" Content="六" />
            <ToggleButton x:Name="Dw0" Style="{StaticResource DowTgl}" Content="日" />
          </StackPanel>
          <TextBlock FontSize="9.5" Foreground="#A5AEBD" Margin="2,6,0,0"
                     Text="已内置 2026 年法定节假日与调休安排（国办发明电〔2025〕7号），本月累计会自动扣除假日、加上调休上班日。" />

          <TextBlock Text="鼓励语气" Style="{StaticResource FieldLabel}" Margin="2,12,0,5" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ToneChillBtn" Style="{StaticResource ToggleIdle}" Content="佛系" Width="62" />
            <Button x:Name="ToneSavageBtn" Style="{StaticResource ToggleIdle}" Content="毒舌" Width="62" Margin="6,0,0,0" />
            <Button x:Name="ToneHypeBtn" Style="{StaticResource ToggleIdle}" Content="热血" Width="62" Margin="6,0,0,0" />
          </StackPanel>

          <TextBlock Text="界面主题" Style="{StaticResource FieldLabel}" Margin="2,12,0,5" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ThemeLightBtn" Style="{StaticResource ToggleIdle}" Content="浅色" Width="62" />
            <Button x:Name="ThemeDarkBtn" Style="{StaticResource ToggleIdle}" Content="深色" Width="62" Margin="6,0,0,0" />
            <Button x:Name="CompactToggleBtn" Style="{StaticResource ToggleIdle}" Content="极简模式" Width="80" Margin="6,0,0,0" />
            <Button x:Name="ClickThroughToggleBtn" Style="{StaticResource ToggleIdle}" Content="鼠标穿透" Width="80" Margin="6,0,0,0" />
          </StackPanel>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="窗体透明度" Style="{StaticResource FieldLabel}" />
              <Slider x:Name="OpacitySlider" Style="{StaticResource SlimSlider}"
                      Minimum="0.45" Maximum="1" Value="0.97"
                      TickFrequency="0.01" IsSnapToTickEnabled="False"
                      SmallChange="0.01" LargeChange="0.05" />
            </StackPanel>
            <TextBlock x:Name="OpacityValueText" Grid.Column="1" FontSize="11" FontWeight="Bold"
                       FontFamily="Consolas" Foreground="#0F172A" VerticalAlignment="Center"
                       Margin="10,0,0,0" Text="97%" />
          </Grid>

          <Grid Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="窗体大小" Style="{StaticResource FieldLabel}" />
              <TextBlock x:Name="SizeText" FontSize="10" Foreground="#475467" Text="456 × 644" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="SizeSmallBtn" Style="{StaticResource GhostBtn}" Content="小" Width="34" Height="30" />
              <Button x:Name="SizeMidBtn" Style="{StaticResource GhostBtn}" Content="中" Width="34" Height="30" Margin="6,0,0,0" />
              <Button x:Name="SizeBigBtn" Style="{StaticResource GhostBtn}" Content="大" Width="34" Height="30" Margin="6,0,0,0" />
              <Button x:Name="ResetSizeBtn" Style="{StaticResource GhostBtn}" Content="重置尺寸"
                      Width="76" Height="30" Margin="6,0,0,0" />
            </StackPanel>
          </Grid>

          <Border Margin="0,14,0,0" Background="#FBFCFE"
                  BorderBrush="#EFF2F7" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <StackPanel>
              <TextBlock Text="按当前输入预估" FontSize="10.5" Foreground="#8A94A6" />
              <TextBlock x:Name="PrevText" Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="#475467" TextWrapping="Wrap" LineHeight="18" Text="—" />
            </StackPanel>
          </Border>

          <TextBlock Text="数据导出与导入" Style="{StaticResource FieldLabel}" Margin="2,14,0,5" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ExportCsvBtn" Style="{StaticResource GhostBtn}" Content="导出工时 CSV" Width="102" Height="32" />
            <Button x:Name="ExportCfgBtn" Style="{StaticResource GhostBtn}" Content="导出配置" Width="82" Height="32" Margin="6,0,0,0" />
            <Button x:Name="ImportCfgBtn" Style="{StaticResource GhostBtn}" Content="导入配置" Width="82" Height="32" Margin="6,0,0,0" />
          </StackPanel>
          <TextBlock FontSize="9.5" Foreground="#A5AEBD" Margin="2,6,0,0" TextWrapping="Wrap"
                     Text="CSV 按天记录实际在场时长与当日已赚，可直接用 Excel 打开做工时报表。" />

          <TextBlock TextWrapping="Wrap" Margin="2,10,2,0"
                     FontSize="10" Foreground="#A5AEBD" LineHeight="17"
                     Text="提示：程序运行且处于上班时段内即视为在岗，实际在场时长会累计进 CSV 报表；午休时段不计入计薪工时。" />

          </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Grid Margin="0,0,0,0">
              <Button x:Name="DefaultBtn" Style="{StaticResource GhostBtn}" Content="恢复默认" Width="82" HorizontalAlignment="Left" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostBtn}" Content="取消" Width="66" />
                <Button x:Name="SaveBtn" Style="{StaticResource PrimaryBtn}" Content="保存" Width="76" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>

            <TextBox x:Name="SettingsTip" FontSize="10" Foreground="#EF4444" Margin="2,8,0,0"
                     Text="" TextWrapping="Wrap" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" BorderThickness="0" Padding="0" />
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
              <Button x:Name="SettingsCopyPathBtn" Style="{StaticResource GhostBtn}"
                      Content="复制路径" Width="76" Height="26" />
              <Button x:Name="SettingsOpenFolderBtn" Style="{StaticResource GhostBtn}"
                      Content="打开文件夹" Width="86" Height="26" Margin="6,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
     </Grid>
    </Viewbox>
  </Grid>

  <!--
    窗口边缘缩放热区。全部落在 RootGrid 的 16px 外圈里，不遮挡任何内容。
    边条 12px、角落 16px，鼠标移上去会显示对应方向的缩放光标。
  -->
  <Rectangle x:Name="GripTop" Style="{StaticResource ResizeGrip}"
             Height="12" VerticalAlignment="Top" Cursor="SizeNS" />
  <Rectangle x:Name="GripBottom" Style="{StaticResource ResizeGrip}"
             Height="12" VerticalAlignment="Bottom" Cursor="SizeNS" />
  <Rectangle x:Name="GripLeft" Style="{StaticResource ResizeGrip}"
             Width="12" HorizontalAlignment="Left" Cursor="SizeWE" />
  <Rectangle x:Name="GripRight" Style="{StaticResource ResizeGrip}"
             Width="12" HorizontalAlignment="Right" Cursor="SizeWE" />

  <Rectangle x:Name="GripTopLeft" Style="{StaticResource ResizeGrip}"
             Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
  <Rectangle x:Name="GripTopRight" Style="{StaticResource ResizeGrip}"
             Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
  <Rectangle x:Name="GripBottomLeft" Style="{StaticResource ResizeGrip}"
             Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
  <Rectangle x:Name="GripBottomRight" Style="{StaticResource ResizeGrip}"
             Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
  </Grid>
</Window>
