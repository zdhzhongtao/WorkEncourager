<Window x:Class="MdViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MdViewer"
        Title="设置" Height="700" Width="580"
        MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBg}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <local:HexBrushConverter x:Key="HexBrush" />

        <!-- 主题下拉里的小色板：底色 + 边线 + 强调色一点，比光看名字直观 -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="20" CornerRadius="3"
                        Background="{Binding Bg, Converter={StaticResource HexBrush}}"
                        BorderBrush="{Binding Line, Converter={StaticResource HexBrush}}"
                        BorderThickness="1">
                    <Border Width="9" Height="9" CornerRadius="4.5"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                            Background="{Binding Accent, Converter={StaticResource HexBrush}}" />
                </Border>
                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextPrimary}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}" Padding="18,13"
                BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,0,1">
            <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeTextPrimary}" />
        </Border>

        <!-- 内容 -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,20">
            <StackPanel>

                <!-- 外观 -->
                <Border x:Name="SectionAppearance" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                        <TextBlock Text="深浅模式" Style="{StaticResource LabelText}" Margin="0,0,0,7" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="theme"
                                         Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="theme"
                                         Checked="Theme_Changed" />
                            <RadioButton x:Name="ThemeDark" Content="深色" GroupName="theme"
                                         Checked="Theme_Changed" />
                        </StackPanel>

                        <TextBlock Text="浅色时用哪套主题" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <ComboBox x:Name="LightThemeBox" Margin="0,0,0,12"
                                  ItemTemplate="{StaticResource ThemeItemTemplate}"
                                  SelectionChanged="ThemeBox_Changed" />

                        <TextBlock Text="深色时用哪套主题" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                        <ComboBox x:Name="DarkThemeBox" Margin="0,0,0,16"
                                  ItemTemplate="{StaticResource ThemeItemTemplate}"
                                  SelectionChanged="ThemeBox_Changed" />

                        <TextBlock Text="正文字号" Style="{StaticResource LabelText}" Margin="0,0,0,7" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="−" Style="{StaticResource GhostButton}" Padding="11,3" FontSize="14"
                                    Click="FontSmaller_Click" />
                            <TextBlock x:Name="FontValue" Text="16" Width="46" TextAlignment="Center"
                                       FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextPrimary}" />
                            <Button Content="+" Style="{StaticResource GhostButton}" Padding="11,3" FontSize="14"
                                    Click="FontBigger_Click" />
                            <TextBlock Text="14 ~ 22 px，只影响正文，不改标题比例" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="字体" Style="{StaticResource LabelText}" Margin="0,0,0,7" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="正文" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FontBodyBox" IsEditable="True"
                                      Margin="0,0,0,6" SelectionChanged="FontBox_Changed"
                                      LostFocus="FontBox_LostFocus" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="代码" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,10,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontCodeBox" IsEditable="True"
                                      Margin="0,0,0,6" SelectionChanged="FontBox_Changed"
                                      LostFocus="FontBox_LostFocus" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="标题" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FontHeadingBox" IsEditable="True"
                                      SelectionChanged="FontBox_Changed" LostFocus="FontBox_LostFocus" />

                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Content="跟随主题"
                                    Style="{StaticResource GhostButton}" Padding="11,4" Margin="10,0,0,0"
                                    VerticalAlignment="Center" Click="FontReset_Click"
                                    ToolTip="清空三个字体，回到主题自带的字体栈" />
                        </Grid>
                        <TextBlock Text="可以直接敲字体名（比如 Microsoft YaHei、LXGW WenKai、JetBrains Mono）。留空就是用主题自带的字体；标题留空会跟着正文走。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="正文宽度" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="WidthValue" DockPanel.Dock="Right" Text="880 px"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="WidthSlider" Minimum="640" Maximum="1400" SmallChange="20"
                                LargeChange="80" IsSnapToTickEnabled="False" TickFrequency="1"
                                ValueChanged="WidthSlider_ValueChanged" />
                        <TextBlock Text="窄一点每行字少，眼睛不容易串行；宽一点表格更好看。多列表格请用工具栏的「宽屏」，正文会铺满窗口。"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 阅读 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="阅读" Style="{StaticResource SectionText}" Margin="0,0,0,12" />

                        <CheckBox x:Name="AutoReloadBox" Content="文件被别的程序改动后自动刷新"
                                  Margin="0,0,0,12" Click="Option_Changed"
                                  ToolTip="用编辑器保存、git 切换分支、同步盘更新，都会自动重新渲染" />
                        <CheckBox x:Name="RememberScrollBox" Content="重新打开同一篇文档时回到上次读到的位置"
                                  Margin="0,0,0,12" Click="Option_Changed" />
                        <CheckBox x:Name="TocVisibleBox" Content="默认显示左侧目录"
                                  Click="Option_Changed" />

                        <CheckBox x:Name="AutoDimBox" Content="到点自动切深色（晚上看更舒服）"
                                  Margin="0,14,0,8" Click="Option_Changed" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="从" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBox x:Name="DimFromBox" Width="62" Padding="6,4" Margin="6,0,0,0"
                                     FontSize="12.5" TextAlignment="Center" LostFocus="DimBox_LostFocus" />
                            <TextBlock Text="到" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBox x:Name="DimToBox" Width="62" Padding="6,4" Margin="6,0,0,0"
                                     FontSize="12.5" TextAlignment="Center" LostFocus="DimBox_LostFocus" />
                            <TextBlock Text="24 小时制，跨夜也行" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="只是临时套用深色主题，不改你在上面选的偏好；出了这个时间段会自动换回来。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <TextBlock Text="用外部程序编辑（Ctrl+Shift+E）" Style="{StaticResource LabelText}"
                                   Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="BrowseEditorButton" DockPanel.Dock="Right" Content="浏览…"
                                    Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                                    Click="BrowseEditor_Click" />
                            <TextBox x:Name="EditorBox" Padding="7,5" FontSize="12.5"
                                     LostFocus="EditorBox_LostFocus" />
                        </DockPanel>
                        <TextBlock Text="留空就自动找 VS Code / Typora / Notepad++ / Sublime / 记事本。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 文件关联 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="文件关联" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                        <TextBlock x:Name="AssocStatus" Style="{StaticResource LabelText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AssocButton" Content="关联 .md" Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" Click="Assoc_Click" />
                            <Button x:Name="UnassocButton" Content="取消关联" Style="{StaticResource GhostButton}"
                                    Padding="14,6" Margin="10,0,0,0" Click="Unassoc_Click" />
                        </StackPanel>
                        <TextBlock Text="只写当前用户的注册表（HKCU），不需要管理员，也不抢别的程序已经占用的默认关联。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- 更新 -->
                <Border x:Name="SectionUpdateCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="更新" Style="{StaticResource SectionText}" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="当前版本" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="—"
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Text="发布仓库（owner/repo）" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <TextBox x:Name="RepoBox" Padding="7,5" FontSize="12.5" Margin="0,0,0,10"
                                 LostFocus="RepoBox_LostFocus" />
                        <TextBlock Text="只有在下面点「检查更新」时才会联网，平时本程序不发任何请求。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <CheckBox x:Name="CheckOnStartBox" Content="启动时静默检查一次（有新版本才提示）"
                                  Margin="0,0,0,12" Click="Option_Changed" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" Click="CheckUpdate_Click" />
                            <Button x:Name="InstallButton" Content="下载并安装" Style="{StaticResource GhostButton}"
                                    Padding="14,6" Margin="10,0,0,0" Visibility="Collapsed"
                                    Click="InstallUpdate_Click" />
                            <Button x:Name="SkipButton" Content="跳过这个版本" Style="{StaticResource GhostButton}"
                                    Padding="14,6" Margin="10,0,0,0" Visibility="Collapsed"
                                    Click="SkipUpdate_Click" />
                        </StackPanel>

                        <ProgressBar x:Name="DownloadBar" Height="3" Margin="0,12,0,0" Visibility="Collapsed"
                                     Foreground="{DynamicResource ThemeAccent}"
                                     Background="{DynamicResource ThemeDivider}" BorderThickness="0"
                                     Minimum="0" Maximum="1" />

                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="UpdateNotes" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="120"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 重置 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="重置" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ResetButton" Content="恢复默认设置" Style="{StaticResource GhostButton}"
                                    Padding="14,6" Click="ResetSettings_Click" />
                        </StackPanel>
                        <TextBlock Text="外观（明暗、主题、字号、正文宽度、宽屏）、阅读开关、更新配置回到出厂值。最近打开、每篇读到的位置、窗口大小会保留 —— 那些是你的使用痕迹，不是设置。重置前会自动备份一份 settings.json 到数据目录。"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                    Padding="12,5" Click="OpenDataDir_Click" />
                            <Button Content="查看日志" Style="{StaticResource GhostButton}"
                                    Padding="12,5" Margin="8,0,0,0" Click="OpenLog_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardBg}" Padding="16,10"
                BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="完成" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Padding="20,6" Click="Close_Click" IsDefault="True" />
                <TextBlock Text="改动立即生效，不需要保存" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
