<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>MdViewer</AssemblyName>
    <RootNamespace>MdViewer</RootNamespace>
    <Product>Markdown 阅读器</Product>
    <AssemblyTitle>Markdown 阅读器</AssemblyTitle>

    <Version>0.5.4</Version>
    <Company>zhend</Company>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- exe、快捷方式、资源管理器里显示的图标 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MdViewer.Core\MdViewer.Core.csproj" />
  </ItemGroup>

  <!-- Web 工具箱：单文件 HTML，编译时嵌进 exe，按钮点开时释放到本地用浏览器打开 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\toolbox.html" LogicalName="MdViewer.Assets.toolbox.html" Condition="Exists('Assets\toolbox.html')" />
  </ItemGroup>

  <!-- 主项目只编译根目录源码，排除子项目里的文件 -->
  <ItemGroup>
    <Compile Remove="MdViewer.Core\**\*.cs" />
    <Compile Remove="MdViewer.Tests\**\*.cs" />
    <None Remove="MdViewer.Core\**" />
    <None Remove="MdViewer.Tests\**" />
    <EmbeddedResource Remove="MdViewer.Core\**" />
    <EmbeddedResource Remove="MdViewer.Tests\**" />
  </ItemGroup>

</Project>
