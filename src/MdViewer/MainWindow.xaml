<Window x:Class="MdViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown 阅读器"
        Height="820" Width="1200" MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 最近打开列表的一行：文件名在左、目录在下面、相对时间在右 -->
        <DataTemplate x:Key="RecentItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{Binding NameFg}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Dir}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource ThemeTextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11.5" Margin="12,0,2,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RecentListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemTemplate" Value="{StaticResource RecentItemTemplate}" />
        </Style>

        <!-- 主题面板的一行：左侧色块预览，右侧名称，当前主题打勾 -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <Border x:Name="ThemeRowBorder" Background="Transparent" CornerRadius="6"
                    Padding="8,5" Cursor="Hand" MouseLeftButtonUp="ThemeRow_Click"
                    ToolTip="{Binding Note}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="32" Height="20" CornerRadius="4"
                            Background="{Binding SwatchBg}"
                            BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
                        <TextBlock Text="Aa" FontSize="10.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{Binding SwatchFg}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="✓" FontSize="12"
                               Visibility="{Binding CheckVisibility}"
                               Foreground="{DynamicResource ThemeAccent}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ThemeRowBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThemeRowBorder" Property="Background"
                            Value="{DynamicResource ThemeHoverBg}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ 工具栏 ══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}"
                BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}"
                            Padding="13,6" Click="Open_Click" ToolTip="打开文件 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Data="M1.9,12.1 L1.9,4.9 A1.1,1.1 0 0 1 3,3.8 L6.1,3.8 L7.6,5.5 L13,5.5 A1.1,1.1 0 0 1 14.1,6.6 L14.1,12.1 A1.1,1.1 0 0 1 13,13.2 L3,13.2 A1.1,1.1 0 0 1 1.9,12.1 Z" />
                            <TextBlock Text="打开" Style="{StaticResource BtnLabel}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecentButton" Style="{StaticResource GhostButton}"
                            Padding="10,6" Margin="6,0,0,0" Click="Recent_Click"
                            ToolTip="最近打开过的文件 (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}"
                                  Data="M8,2.3 A5.7,5.7 0 1 0 8,13.7 A5.7,5.7 0 1 0 8,2.3 Z M8,4.9 L8,8.2 L10.4,9.6" />
                            <TextBlock Text="最近" Style="{StaticResource BtnLabel}" Margin="7,0,0,0" />
                            <Path Style="{StaticResource IconPath}" Width="9" Height="9" StrokeThickness="1.6"
                                  Margin="5,1,0,0" Data="M3,6 L8,11 L13,6" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource ThemeDivider}"
                            Margin="9,0" VerticalAlignment="Center" />

                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="Back_Click"
                            ToolTip="上一份文档 (Alt+←)" IsEnabled="False">
                        <Path Style="{StaticResource IconPath}" Data="M9.8,3.4 L5.2,8 L9.8,12.6" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="Forward_Click"
                            ToolTip="下一份文档 (Alt+→)" IsEnabled="False" Margin="2,0,0,0">
                        <Path Style="{StaticResource IconPath}" Data="M6.2,3.4 L10.8,8 L6.2,12.6" />
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource ThemeDivider}"
                            Margin="9,0" VerticalAlignment="Center" />

                    <CheckBox x:Name="TocToggle" VerticalAlignment="Center" IsChecked="True"
                              Click="TocToggle_Click" ToolTip="显示 / 隐藏左侧目录，关掉正文更宽 (Ctrl+T)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" StrokeThickness="1.5" Width="15" Height="15"
                                  Stroke="{DynamicResource ThemeTextSecondary}"
                                  Data="M2.6,4 H13.4 M2.6,8 H13.4 M2.6,12 H9.4" />
                            <TextBlock Text="目录" Style="{StaticResource BtnLabel}" Margin="6,0,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="WideToggle" VerticalAlignment="Center" Margin="12,0,0,0"
                              Click="WideToggle_Click" ToolTip="宽屏：正文铺满窗口并收起目录，多列表格改成左右滚动 (Ctrl+Shift+W)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" StrokeThickness="1.5" Width="15" Height="15"
                                  Stroke="{DynamicResource ThemeTextSecondary}"
                                  Data="M2.2,8 H13.8 M5,4.7 L2.1,8 L5,11.3 M11,4.7 L13.9,8 L11,11.3" />
                            <TextBlock Text="宽屏" Style="{StaticResource BtnLabel}" Margin="6,0,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                            Click="Reload_Click" ToolTip="重新读取这个文件 (F5)">
                        <Path Style="{StaticResource IconPath}"
                              Data="M12.7,4.6 A5.2,5.2 0 1 0 13.2,9.4 M13.1,2.2 L13.1,5.6 L9.7,5.6" />
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource ThemeDivider}"
                            Margin="9,0" VerticalAlignment="Center" />

                    <TextBlock Text="字号" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <Button Content="−" Style="{StaticResource GhostButton}" Padding="9,2" Margin="6,0,0,0"
                            FontSize="14" Click="FontSmaller_Click" ToolTip="缩小正文字号 (Ctrl+减号)" />
                    <TextBlock x:Name="FontLabel" Text="16" Width="24" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" />
                    <Button Content="+" Style="{StaticResource GhostButton}" Padding="9,2"
                            FontSize="14" Click="FontBigger_Click" ToolTip="放大正文字号 (Ctrl+加号)" />

                    <Border Width="1" Height="20" Background="{DynamicResource ThemeDivider}"
                            Margin="9,0" VerticalAlignment="Center" />

                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}"
                            Click="ThemeMenu_Click" ToolTip="主题">
                        <Path x:Name="ThemeIcon" Style="{StaticResource IconPath}"
                              Data="M13.2,9.4 A5.4,5.4 0 1 1 6.6,2.8 A4.4,4.4 0 0 0 13.2,9.4 Z" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UpdateBadge" Style="{StaticResource BadgeButton}" Visibility="Collapsed"
                            Click="UpdateBadge_Click" ToolTip="有新版本可用，点这里查看">
                        <TextBlock x:Name="UpdateBadgeText" Text="有新版本" />
                    </Button>

                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click"
                            ToolTip="设置 (Ctrl+,)">
                        <Path Style="{StaticResource IconPath}"
                              Data="M2.8,4.6 H13.2 M2.8,8 H13.2 M2.8,11.4 H13.2 M5.6,2.8 V6.4 M10.4,6.2 V9.8 M7.2,9.6 V13.2" />
                    </Button>

                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                            Click="More_Click" ToolTip="更多">
                        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource ThemeBtnFg}" Stroke="{x:Null}"
                              Data="M8,2.6 A1.25,1.25 0 1 0 8,5.1 A1.25,1.25 0 1 0 8,2.6 Z M8,6.75 A1.25,1.25 0 1 0 8,9.25 A1.25,1.25 0 1 0 8,6.75 Z M8,10.9 A1.25,1.25 0 1 0 8,13.4 A1.25,1.25 0 1 0 8,10.9 Z" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════ 搜索条 ══════════ -->
        <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Padding="10,6"
                Background="{DynamicResource ThemeCardBg}"
                BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="搜索" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBox x:Name="FindBox" Width="300" Margin="8,0,0,0" Padding="6,4"
                         TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                <TextBlock x:Name="FindLabel" Text="0/0" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="10,0" MinWidth="52" />
                <Button Content="上一个" Style="{StaticResource GhostButton}" Padding="10,4"
                        Click="FindPrev_Click" />
                <Button Content="下一个" Style="{StaticResource GhostButton}" Padding="10,4"
                        Margin="6,0,0,0" Click="FindNext_Click" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" Padding="10,4"
                        Margin="6,0,0,0" Click="FindClose_Click" />
            </StackPanel>
        </Border>

        <!-- ══════════ 主体：目录 + 正文 ══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="240" MinWidth="0" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TocPanel" Grid.Column="0" Background="{DynamicResource ThemeNavBg}"
                    BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TocTitle" Text="目录" Style="{StaticResource SectionText}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TocCount" Grid.Column="1" Text="" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="TocList" Margin="6,0,6,8"
                             SelectionChanged="TocList_SelectionChanged"
                             PreviewMouseLeftButtonUp="TocList_PreviewMouseLeftButtonUp"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}"
                                           Margin="{Binding Indent}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2" Background="{DynamicResource ThemeCardBg}">
                <wv2:WebView2 x:Name="View" DefaultBackgroundColor="White" />

                <!-- 欢迎 / 起始页（没打开文件时显示） -->
                <Border x:Name="WelcomePanel" Background="{DynamicResource ThemeCardBg}"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10">
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center"
                                    MaxWidth="660" Margin="24,34,24,40">

                            <Border Width="72" Height="72" HorizontalAlignment="Center" CornerRadius="17">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                                        <GradientStop Color="#6394F4" Offset="0" />
                                        <GradientStop Color="#355CD6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Canvas Width="58" Height="58" Margin="9">
                                    <Path Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M8,41 L8,17 L19,31 L30,17 L30,41" />
                                    <Path Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M44,17 L44,38 M37,31 L44,41 L51,31" />
                                </Canvas>
                            </Border>

                            <TextBlock Text="Markdown 阅读器" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="把 .md 或 .epub 拖进来，或者点下面打开"
                                       Style="{StaticResource LabelText}" HorizontalAlignment="Center"
                                       Margin="0,7,0,0" FontSize="12.5" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="16,7" Click="Open_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}"
                                              Data="M1.9,12.1 L1.9,4.9 A1.1,1.1 0 0 1 3,3.8 L6.1,3.8 L7.6,5.5 L13,5.5 A1.1,1.1 0 0 1 14.1,6.6 L14.1,12.1 A1.1,1.1 0 0 1 13,13.2 L3,13.2 A1.1,1.1 0 0 1 1.9,12.1 Z" />
                                        <TextBlock Text="打开文件" Style="{StaticResource BtnLabel}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Content="看样例" Style="{StaticResource GhostButton}" Padding="16,7"
                                        Margin="10,0,0,0" Click="Demo_Click"
                                        ToolTip="打开一份功能齐全的示例文档" />
                            </StackPanel>

                            <!-- 最近打开 -->
                            <Border x:Name="WelcomeRecentBox" Margin="0,26,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="2,0,2,6">
                                        <TextBlock Text="最近打开" Style="{StaticResource SectionText}" />
                                        <TextBlock x:Name="WelcomeRecentHint" DockPanel.Dock="Right"
                                                   Text="双击打开" Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Background="{DynamicResource ThemeNavBg}" CornerRadius="10"
                                            BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="1"
                                            Padding="6,5">
                                        <ListBox x:Name="WelcomeRecentList" Style="{StaticResource RecentListStyle}"
                                                 MaxHeight="228" MouseDoubleClick="WelcomeRecentList_DoubleClick"
                                                 KeyDown="WelcomeRecentList_KeyDown" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0" MaxWidth="600">
                                <Border Style="{StaticResource KeyBadge}">
                                    <TextBlock Text="Ctrl+O 打开" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border Style="{StaticResource KeyBadge}">
                                    <TextBlock Text="Ctrl+F 搜索" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border Style="{StaticResource KeyBadge}">
                                    <TextBlock Text="F5 刷新" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border Style="{StaticResource KeyBadge}">
                                    <TextBlock Text="Ctrl+滚轮 缩放" Style="{StaticResource MutedText}" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Margin="0,16,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="想双击就用本程序打开？在设置里点一次「关联 .md」，再在系统的「打开方式」里勾一次「始终使用」。" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- WebView2 运行时缺失时的降级界面 -->
                <Border x:Name="FallbackPanel" Background="{DynamicResource ThemeCardBg}"
                        Visibility="Collapsed">
                    <DockPanel Margin="24">
                        <Border DockPanel.Dock="Top" Padding="14" Margin="0,0,0,12" CornerRadius="8"
                                Background="{DynamicResource ThemeHoverBg}">
                            <StackPanel>
                                <TextBlock Text="没找到 WebView2 运行时，先用纯文本方式显示。"
                                           Style="{StaticResource SectionText}" />
                                <TextBlock x:Name="FallbackReason" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="去下载 WebView2" Style="{StaticResource PrimaryButton}"
                                            Padding="14,6" Click="DownloadWebView_Click" />
                                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Text="装好后重启本程序即可恢复排版显示。" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="PlainText" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="14"
                                 Background="{DynamicResource ThemeInputBg}"
                                 Foreground="{DynamicResource ThemeInputFg}" BorderThickness="0" />
                    </DockPanel>
                </Border>

                <!-- 正在解析 EPUB 之类耗时任务的提示 -->
                <Border x:Name="BusyPanel" Background="{DynamicResource ThemeCardBg}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="3"
                                     Foreground="{DynamicResource ThemeAccent}"
                                     Background="{DynamicResource ThemeDivider}" BorderThickness="0" />
                        <TextBlock x:Name="BusyText" Text="正在打开…" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- 轻量通知：导出成功这类「只是告诉你一声」的事，不该弹模态框拦着人。
                     几秒后自己消失，鼠标移上去就停住不走，点 ✕ 直接关 -->
                <Border x:Name="Toast" Panel.ZIndex="20" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18"
                        MaxWidth="430" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10,12,10"
                        MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.16" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ToastClose" DockPanel.Dock="Right" Content="✕"
                                    Style="{StaticResource IconButton}" Width="22" Height="22"
                                    Padding="0" FontSize="11" Margin="10,0,0,0"
                                    VerticalAlignment="Top" ToolTip="关掉" Click="ToastClose_Click" />
                            <TextBlock x:Name="ToastTitle" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="ToastDetail" Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="ToastActions" Orientation="Horizontal" Margin="0,9,0,0"
                                    Visibility="Collapsed">
                            <Button x:Name="ToastOpen" Content="打开" Style="{StaticResource GhostButton}"
                                    Padding="10,3" FontSize="11.5" Click="ToastOpen_Click" />
                            <Button x:Name="ToastReveal" Content="所在文件夹" Style="{StaticResource GhostButton}"
                                    Padding="10,3" FontSize="11.5" Margin="6,0,0,0" Click="ToastReveal_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════ 状态栏 ══════════ -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeCardBg}" Padding="12,5"
                BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ReloadHint" Text="已重新载入" Foreground="{DynamicResource ThemeSuccess}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="AutoWatchHint" Text="● 自动刷新" FontSize="11.5"
                               Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"
                               Margin="0,0,10,0" Visibility="Collapsed"
                               ToolTip="这个文件被别的程序改动后会自动重新渲染" />
                    <TextBlock x:Name="AssocLabel" Text="未关联" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusRight" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusPath" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ══════════ 最近打开下拉面板 ══════════ -->
        <Popup x:Name="RecentPopup" PlacementTarget="{Binding ElementName=RecentButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="4">
            <Border Width="480" Background="{DynamicResource ThemeCardBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,7">
                        <TextBox x:Name="RecentFilter" Padding="7,5" FontSize="12.5"
                                 TextChanged="RecentFilter_TextChanged"
                                 KeyDown="RecentFilter_KeyDown"
                                 ToolTip="输入文件名或路径片段来过滤">
                        </TextBox>
                        <TextBlock x:Name="RecentFilterHint" Text="过滤…" IsHitTestVisible="False"
                                   Foreground="{DynamicResource ThemeTextMuted}" FontSize="12.5"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Margin="2,6,2,0" Padding="0,6,0,0"
                            BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock x:Name="RecentEmpty" Text="还没有打开过文件"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <Button Content="清空列表" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11.5"
                                    Click="RecentClear_Click" />
                            <TextBlock Text="↑↓ 选择 · Enter 打开 · Del 移除" Style="{StaticResource MutedText}"
                                       FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="RecentList" Style="{StaticResource RecentListStyle}"
                             MaxHeight="380" MinHeight="60"
                             SelectionChanged="RecentList_SelectionChanged"
                             MouseDoubleClick="RecentList_MouseDoubleClick"
                             KeyDown="RecentList_KeyDown" />
                </DockPanel>
            </Border>
        </Popup>

        <!-- ══════════ 主题面板 ══════════ -->
        <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="4">
            <Border Width="252" Background="{DynamicResource ThemeCardBg}" CornerRadius="10"
                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="浅色" Style="{StaticResource MutedText}" Margin="9,4,0,3" />
                    <ItemsControl x:Name="ThemeListLight"
                                  ItemTemplate="{StaticResource ThemeItemTemplate}" />

                    <Border Height="1" Background="{DynamicResource ThemeDivider}" Margin="7,7" />

                    <TextBlock Text="深色" Style="{StaticResource MutedText}" Margin="9,4,0,3" />
                    <ItemsControl x:Name="ThemeListDark"
                                  ItemTemplate="{StaticResource ThemeItemTemplate}" />

                    <Border Height="1" Background="{DynamicResource ThemeDivider}" Margin="7,7" />

                    <TextBlock Text="想跟着 Windows 自动切？设置 → 外观 → 跟随系统"
                               Style="{StaticResource MutedText}" FontSize="11"
                               Margin="9,0,9,4" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
