<Window x:Class="TableDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表格比对器" Height="760" Width="1080" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="表格比对器" Style="{StaticResource TitleText}" />
                <TextBlock Text="两张表按主键找差异，红黄绿高亮，导出差异清单"
                           Style="{StaticResource MutedText}" Margin="12,0,0,2" VerticalAlignment="Bottom" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ThemeButton" Content="深色模式" Style="{StaticResource GhostButton}"
                        Click="ThemeButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 两个文件槽 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="表 A" Style="{StaticResource SectionText}" FontSize="14" />
                        <TextBlock x:Name="InfoA" Text="未选择文件" Style="{StaticResource MutedText}"
                                   Margin="8,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathABox" IsReadOnly="True" ToolTip="把文件拖进窗口也可以" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="BrowseA_Click" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="工作表" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="SheetACombo" Grid.Column="1" Margin="8,0,0,0"
                                  SelectionChanged="SheetA_SelectionChanged" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="表 B" Style="{StaticResource SectionText}" FontSize="14" />
                        <TextBlock x:Name="InfoB" Text="未选择文件" Style="{StaticResource MutedText}"
                                   Margin="8,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBBox" IsReadOnly="True" ToolTip="把文件拖进窗口也可以" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="BrowseB_Click" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="工作表" Style="{StaticResource LabelText}" />
                        <ComboBox x:Name="SheetBCombo" Grid.Column="1" Margin="8,0,0,0"
                                  SelectionChanged="SheetB_SelectionChanged" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 比对方式与选项 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="比对方式" Style="{StaticResource LabelText}" Margin="0,0,12,0" />
                    <RadioButton x:Name="ModeKeyRadio" Content="按主键" GroupName="mode" IsChecked="True"
                                 Checked="Mode_Changed" Margin="0,0,16,0" />
                    <RadioButton x:Name="ModePositionRadio" Content="按行位置" GroupName="mode"
                                 Checked="Mode_Changed" Margin="0,0,16,0" />
                    <RadioButton x:Name="ModeRowRadio" Content="按整行内容" GroupName="mode"
                                 Checked="Mode_Changed" />

                    <Border Width="1" Background="{DynamicResource ThemeDivider}" Margin="16,2,16,2" />

                    <TextBlock Text="主键列" Style="{StaticResource LabelText}" Margin="0,0,8,0" />
                    <ComboBox x:Name="Key1Combo" Width="130" />
                    <ComboBox x:Name="Key2Combo" Width="130" Margin="8,0,0,0" />
                    <ComboBox x:Name="Key3Combo" Width="130" Margin="8,0,0,0" />
                </StackPanel>

                <WrapPanel Margin="0,12,0,0">
                    <CheckBox x:Name="IgnoreCaseCheck" Content="忽略大小写" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="IgnoreTrimCheck" Content="忽略首尾空格" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="EmptySameCheck" Content="空单元格与空串视为相同" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="IgnoreBlankCheck" Content="忽略全空行" Margin="0,0,16,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBlock Text="数值容差" Style="{StaticResource LabelText}" Margin="0,0,8,0" />
                    <TextBox x:Name="ToleranceBox" Width="80" Text="0" TextChanged="Tolerance_TextChanged"
                             ToolTip="填 0.01 表示相差 1 分钱以内算相同" />
                    <Button x:Name="MapButton" Content="列映射 / 忽略列…" Style="{StaticResource GhostButton}"
                            Margin="16,0,0,0" Padding="12,3" Click="MapButton_Click" IsEnabled="False" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 操作条 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CompareButton" Content="开始比对" Style="{StaticResource PrimaryButton}"
                    Click="Compare_Click" />
            <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                    Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />

            <ComboBox x:Name="FilterCombo" Grid.Column="3" Width="120" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部行" IsSelected="True" />
                <ComboBoxItem Content="只看差异" />
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="4" Width="200" Margin="8,0,0,0"
                     TextChanged="Search_TextChanged" ToolTip="按任意列包含匹配" />
            <Button x:Name="ExportCsvButton" Grid.Column="5" Content="导出差异清单…"
                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsEnabled="False"
                    Click="ExportCsv_Click" />
            <Button x:Name="ExportXlsxButton" Grid.Column="6" Content="导出差异报告…"
                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsEnabled="False"
                    Click="ExportXlsx_Click" />
        </Grid>

        <!-- 汇总条 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="A 行数" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatA" Text="—" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="B 行数" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatB" Text="—" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="相同" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatSame" Text="—" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="仅A" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatOnlyA" Text="—" FontWeight="SemiBold" Margin="6,0,16,0"
                       Foreground="{DynamicResource ThemeOnlyAFg}" VerticalAlignment="Center" />
            <TextBlock Text="仅B" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatOnlyB" Text="—" FontWeight="SemiBold" Margin="6,0,16,0"
                       Foreground="{DynamicResource ThemeOnlyBFg}" VerticalAlignment="Center" />
            <TextBlock Text="差异行" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatChangedRows" Text="—" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="差异单元格" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatChangedCells" Text="—" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
            <Button x:Name="DupButton" Content="" Style="{StaticResource GhostButton}" Padding="8,2"
                    Visibility="Collapsed" Click="Dup_Click" Foreground="{DynamicResource ThemeWarning}" />
        </StackPanel>

        <!-- 结果表 -->
        <DataGrid x:Name="Grid" Grid.Row="5" Margin="0,8,0,0" Style="{StaticResource DataGridStyle}" />

        <!-- 状态栏 -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="就绪：先把两个文件拖进来，或者点「浏览…」"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Width="220" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
