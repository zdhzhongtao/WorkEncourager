<Window x:Class="SheetSplitter.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览源表" Height="520" Width="900" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" />

        <DataGrid x:Name="Grid" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource DataGridStyle}"
                  IsReadOnly="True" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
