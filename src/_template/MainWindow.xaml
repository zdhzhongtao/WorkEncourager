<Window x:Class="ToolTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具模板" Height="420" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="工具模板"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />

        <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="这是一个可编译的最小起点。复制 src/_template 为 src/你的工具名，改掉命名空间和产品名即可开工。详见 docs/新增工具指南.md。" />

        <!-- 内容区：换成你工具的真正界面 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16"
                CornerRadius="8" Background="{StaticResource CardBrush}">
            <StackPanel>
                <TextBlock Text="示例输入" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="InputBox" Margin="0,8,0,0" Padding="8,6"
                         VerticalContentAlignment="Center" />
                <Button x:Name="SaveButton" Content="保存" Margin="0,12,0,0"
                        Padding="20,8" HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="SaveButton_Click" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="就绪" />
    </Grid>
</Window>
