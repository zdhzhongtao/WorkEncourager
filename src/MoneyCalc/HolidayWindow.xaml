<Window x:Class="MoneyCalc.HolidayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑节假日表" Height="560" Width="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource MutedText}"
                   Text="一行一个日期，格式 2026-10-01。左边是放假的法定节假日，右边是周末要上班的调休补班。改完点「确定」立刻生效。" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="法定节假日（放假）" Style="{StaticResource LabelText}" FontWeight="SemiBold" />
                    <TextBox x:Name="HolidayBox" Grid.Row="1" Margin="0,8,0,0" AcceptsReturn="True"
                             VerticalContentAlignment="Top" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="调休补班（上班）" Style="{StaticResource LabelText}" FontWeight="SemiBold" />
                    <TextBox x:Name="MakeupBox" Grid.Row="1" Margin="0,8,0,0" AcceptsReturn="True"
                             VerticalContentAlignment="Top" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="恢复内置 2025–2026" Style="{StaticResource GhostButton}" Click="Restore_Click" />
                <Button Content="一键清空" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Clear_Click" />
                <Button Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
